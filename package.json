{
  "name": "auteko",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "fmt": "prettier --check .",
    "fmt-write": "prettier --write .",
    "lint": "eslint .",
    "types": "npm run types --workspaces --if-present",
    "test": "vitest run",
    "db:migrate": "npm run db:migrate -w apps/web",
    "gate": "npm run fmt && npm run lint && npm run types && npm run test"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "eslint": "10.13.0",
    "fast-check": "4.10.2",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
