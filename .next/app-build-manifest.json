      "static/chunks/app/(app)/batches/page.js"
    ],
    "/(app)/deals/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/(app)/deals/page.js"
    ],
    "/(app)/clients/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/(app)/clients/page.js"
    ],
    "/_not-found/page": [
